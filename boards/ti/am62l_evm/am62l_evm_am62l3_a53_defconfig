# Zephyr Kernel Configuration
CONFIG_XIP=n

# Serial Driver
CONFIG_SERIAL=y

# Enable Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# ARM Options
CONFIG_AARCH64_IMAGE_HEADER=y
CONFIG_ARMV8_A_NS=y
CONFIG_ARM64_VA_BITS_36=y
CONFIG_ARM64_PA_BITS_36=y
CONFIG_ARM_SCMI=y

# Cache Options
CONFIG_CACHE_MANAGEMENT=y
CONFIG_DCACHE_LINE_SIZE_DETECT=y
CONFIG_ICACHE_LINE_SIZE_DETECT=y

# Multicore Support
CONFIG_SMP=y
# CONFIG_SCHED_THREAD_USAGE=y
# CONFIG_SCHED_THREAD_USAGE_ALL=y
CONFIG_PM_CPU_OPS=y
CONFIG_MP_MAX_NUM_CPUS=2
# CONFIG_SCHED_CPU_MASK=y
# CONFIG_CPU_LOAD=y
# CONFIG_CPU_LOAD_USE_COUNTER=y
# CONFIG_WAIT_AT_RESET_VECTOR=y

# Clock Control
CONFIG_CLOCK_CONTROL=y

# Power Domain
CONFIG_PM_DEVICE=y
CONFIG_POWER_DOMAIN=y

# TF-A Build Configuration
CONFIG_BUILD_WITH_TFA=y
CONFIG_TFA_PLATFORM="k3low"
CONFIG_TFA_ARTIFACT_SUBDIR=y
CONFIG_TI_K3_BUILD_TISPL=y
CONFIG_TI_K3_BUILD_TIBOOT3=y
# CONFIG_DISPLAY=y
# CONFIG_TI_DSS=y
# CONFIG_MIPI_DSI=y
# CONFIG_TC358762=y
# CONFIG_MIPI_DSI_CDNS_TI=y

# GPIO — required for RPi panel MCU (reset-gpios) and TCA6424A expander
CONFIG_GPIO=y
CONFIG_I2C=y

# Input — GT911 capacitive touch on RPi Touch Display 2
CONFIG_INPUT=y
CONFIG_DISPLAY_INIT_PRIORITY=91
