&pktdma {
	status = "okay";
};

&cpsw3g {
	status = "okay";
};

&cpsw_mdio {
	status = "okay";

	cpsw_phy1: ethernet-phy@0 {
		compatible = "ti,dp83867";
		reg = <0>;
		ti,interface-type = "rgmii-id";
		ti,rx-internal-delay = <7>; /* 2 ns delay */
		ti,tx-internal-delay = <0>; /* Delay added by MAC */
	};

	cpsw_phy2: ethernet-phy@1 {
		compatible = "ti,dp83867";
		reg = <1>;
		ti,interface-type = "rgmii-id";
		ti,rx-internal-delay = <7>; /* 2 ns delay */
		ti,tx-internal-delay = <0>; /* Delay added by MAC */
	};
};

/* eMMC */
&main_sdhci0 {
	pinctrl-0 = <&mmc0_cmd
		     &mmc0_clk
		     &mmc0_dat0
		     &mmc0_dat1
		     &mmc0_dat2
		     &mmc0_dat3
		     &mmc0_dat4
		     &mmc0_dat5
		     &mmc0_dat6
		     &mmc0_dat7>;
	pinctrl-names = "default";
	status = "okay";

	mmc {
		compatible = "zephyr,mmc-disk";
		bus-width = <8>;
		disk-name = "emmc";
	};
};

/* SD */
&main_sdhci1 {
	pinctrl-0 = <&mmc1_cmd
		     &mmc1_clk
		     &mmc1_dat0
		     &mmc1_dat1
		     &mmc1_dat2
		     &mmc1_dat3
		     &mmc1_sdcd>;
	pinctrl-names = "default";
	status = "okay";

	sd {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "sd";
	};
};

/* SDIO */
&main_sdhci2 {
	pinctrl-0 = <&mmc2_cmd
		     &mmc2_clk
		     &mmc2_clklb
		     &mmc2_dat0
		     &mmc2_dat1
		     &mmc2_dat2
		     &mmc2_dat3>;
	pinctrl-names = "default";
	ti,fails-without-test-cd;
	status = "disabled";
};

