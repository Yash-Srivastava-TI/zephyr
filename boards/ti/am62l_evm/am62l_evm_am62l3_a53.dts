&dss {
	data-width = <24>;
	height = <1280>;
	width  = <720>;

	display-timings {
		compatible = "zephyr,panel-timing";
		clock-frequency = <83330000>;
		hfront-porch    = <239>;
		hback-porch     = <50>;
		hsync-len       = <33>;
		vfront-porch    = <20>;
		vback-porch     = <30>;
		vsync-len       = <2>;
		hsync-active    = <0>;
		vsync-active    = <0>;
		de-active       = <1>;
		pixelclk-active = <0>;
	};

	status = "okay";
};

&dsi0 {
	status = "okay";
	data-lanes = <2>;

	rpi_td2: panel@0 {
		compatible = "raspberrypi,dsi-7inch";
		reg = <0>;
		data-lanes = <2>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
		reset-gpios = <&display_mcu 0 GPIO_ACTIVE_LOW>;
		width = <720>;
		height = <1280>;
		status = "okay";
	};
};
