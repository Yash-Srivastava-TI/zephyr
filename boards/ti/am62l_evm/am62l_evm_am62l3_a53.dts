/dts-v1/;

#include <ti/am62l3_a53.dtsi>
#include "am62l_evm_am62l3_a53-pinctrl.dtsi"
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>

/ {
	model = "TI AM62L EVALUATION MODULE (EVM)";
	compatible = "ti,am62l_evm";

	chosen {
		zephyr,console = &main_uart0;
		zephyr,shell-uart = &main_uart0;
		zephyr,sram = &ddr0;
		zephyr,display = &dss;
		zephyr,touch = &gt911;
	};

	aliases {
		adc0 = &main_adc0;
		led0 = &ld9;
		watchdog0 = &main_rti0;
		sdhc0 = &main_sdhci0;
		sdhc1 = &main_sdhci1;
		sdhc2 = &main_sdhci2;
		mipi-dsi = &dsi0;
	};

	leds: leds {
		compatible = "gpio-leds";

		ld9: led_0 {
			gpios = <&main_gpio0_3 27 GPIO_ACTIVE_HIGH>;
		};
	};

	cpus {
		cpu@0 {
			status = "okay";
		};

		cpu@1 {
			status = "okay";
		};
	};

	ddr0: memory@82000000 {
		reg = <0x82000000 (DT_SIZE_G(2) - DT_SIZE_M(32))>;
	};
};

&main_uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default>,
		    <&uart0_tx_default>;
	pinctrl-names = "default";
	status = "okay";
};

&main_adc0 {
	ti,fifo = <0>;
	pinctrl-0 = <&adc0_ext_trigger0>,
		    <&adc0_ext_trigger1>;
	pinctrl-names = "default";
	status = "okay";

	channel@0 {
		reg = <0>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@1 {
		reg = <1>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@2 {
		reg = <2>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@3 {
		reg = <3>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};
};

&main_gpio0_3 {
	pinctrl-0 = <&main_gpio0_3_led>;
	pinctrl-names = "default";
	status = "disabled";
};

&main_i2c0 {
	pinctrl-0 = <&main_i2c0_scl &main_i2c0_sda>;
	pinctrl-names = "default";
	status = "okay";

	eeprom0: eeprom@51 {
		compatible = "atmel,at24";
		reg = <0x51>;
		address-width = <16>;
		pagesize = <128>;
		size = <65536>;
		timeout = <5>;
	};

	display_mcu: display_mcu@45 {
		compatible = "raspberrypi,touchscreen-panel-regulator-v2";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	/*
	 * GT911 touch controller on the display daughter card.  Per the
	 * official Raspberry Pi Touch Display 2 overlay
	 * (vc4-kms-dsi-ili9881-7inch-overlay.dts), reset is not a GPIO line
	 * at all -- it is power-cycling the touch AVDD28 rail via
	 * display_mcu pin 1 (same chip as the panel reset on pin 0), and
	 * INT is not routed to the host, so GT911 falls back to touch
	 * detection via I2C polling instead of interrupts.  Uses
	 * GPIO_ACTIVE_LOW like the panel's own reset on pin 0 -- gt911_init()
	 * asserts then deasserts the line, and must end up deasserted
	 * (powered on) before it probes the device over I2C.
	 *
	 * input_gt911.c requires irq-gpios unconditionally (it also drives
	 * the pin during the address-strap sequence), so it is pointed at
	 * GPIO0_90 -- the board's spare "User Interrupt" pin, confirmed
	 * unused elsewhere on this schematic -- purely as a placeholder;
	 * nothing is physically wired to it.
	 */
	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		reset-gpios = <&display_mcu 1 GPIO_ACTIVE_LOW>;
		irq-gpios = <&main_gpio0_2 26 GPIO_ACTIVE_HIGH>;
		screen-width = <720>;
		screen-height = <1280>;
	};
};

&main_gpio0_2 {
	pinctrl-0 = <&main_spi0_d0>;
	pinctrl-names = "default";
	status = "okay";
};

&main_i2c1 {
	pinctrl-0 = <&main_i2c1_scl &main_i2c1_sda>;
	pinctrl-names = "default";
	status = "disabled";

	gpio_expander: tca6424a@22 {
		compatible = "ti,tca6424a";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <24>;
		status = "disabled";
	};

	sii9022a: sii9022a@3b {
		compatible = "sil,sii9022a";
		reg = <0x3b>;
		/* HDMI RGB output; pixel clock latched on falling edge */
		output-format = <0>;
		clk-falling;
		display-controller = <&dss>;
		status = "disabled";
	};
};

&main_rti0 {
	status = "okay";
};

